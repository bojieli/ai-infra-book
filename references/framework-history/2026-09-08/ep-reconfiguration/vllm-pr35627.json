ates [NIXL-EP](https://github.com/ai-dynamo/nixl/tree/main/examples/device/ep) kernels into vLLM.\nNIXL-EP is an implementation of expert-parallel communication kernels over [NIXL](https://github.com/ai-dynamo/nixl)'s device API. It provides elastic scaling capabilities, enabling dynamic addition and removal of processes (ranks) during runtime, without the need to destroy and recreate communicators during scaling up/down.\n\nThis PR also includes a few small fixes to vLLM Elastic EP (https://github.com/vllm-project/vllm/pull/34861) that we found while thoroughly testing vLLM with NIXL-EP.","labels":[{"id":7197733874,"node_id":"LA_kwDOI7xefs8AAAABrQSz8g","url":"https://api.github.com/repos/vllm-project/vllm/labels/ready","name":"ready","description":"ONLY add when PR is ready to merge/full CI is needed","color":"ededed","default":false},{"id":8068298936,"node_id":"LA_kwDOI7xefs8AAAAB4Oh4uA","url":"https://api.github.com/repos/vllm-project/vllm/labels/v1","name":"v1","description":"","color":"9810B3","default":false},{"id":9306392211,"node_id":"LA_kwDOI7xefs8AAAACKrRGkw","url":"https://api.github.com/repos/vllm-project/vllm/labels/kv-connector","name":"kv-connector","description":"","color":"4417cb","default":false},{"id":9543357705,"node_id":"LA_kwDOI7xefs8AAAACONQVCQ","url":"https://api.github.com/repos/vllm-project/vllm/labels/nvidia","name":"nvidia","description":"","color":"76B900","default":false}],"milestone":null,"active_lock_reason":null,"created_at":"2026-02-28T21:09:04Z","updated_at":"2026-03-13T13:25:34Z","closed_at":"2026-03-13T13:25:34Z","merged_at":"2026-03-13T13:25:33Z","merge_commit_sha":"d5af196c183bef2e886c7ec12db63b6161cacfde","assignee":null,"assignees":[],"requested_reviewers":[{"login":"mgoin","id":3195154,"node_id":"MDQ6VXNlcjMxOTUxNTQ=","avatar_url":"https://avatars.githubusercontent.com/u/3195154?v=4","gravatar_id":"","url":"https://api.github.com/users/mgoin","html_url":"https://github.com/mgoin","followers_url":"https://api.github.com/users