      "program_order": 152,
      "doi": "10.1145/3676641.3716249",
      "title": "Relax: Composable Abstractions for End-to-End Dynamic Machine Learning",
      "authors": [
        "Lai, Ruihang",
        "Shao, Junru",
        "Feng, Siyuan",
        "Lyubomirsky, Steven S.",
        "Hou, Bohan",
